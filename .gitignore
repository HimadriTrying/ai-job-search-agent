# Personal data — never commit
data/connections/*.csv
data/answer_bank.yaml
# who you're applying to — private
data/tracker.csv
# your live discovery results — private
data/digests/*.md
# ...but keep an example header public
!data/tracker.example.csv

# YOUR real brain — private by default. Commit the *.example versions instead so the
# repo stays forkable without leaking your history. To publish a redacted showcase,
# copy a scrubbed version to profile/… .public.md and un-ignore that specific file.
career_facts.yaml
profile/01-candidate-profile.md
profile/02-behavioral-profile.md
profile/03-writing-style.md
profile/04-job-evaluation.md
profile/05-cv-source.md
profile/06-cover-letter-notes.md
profile/07-interview-prep.md
# Live-process prep context (target company, interviewers, process state) — MOST private file
profile/08-role-prep.md

# ...but DO keep the templates + the README so the repo is usable by others.
!profile/00-README.md
!career_facts.example.yaml
!profile/*.example.md

# Compiled artifacts
*.pdf
*.aux
*.log
*.out

# Env / secrets
.env
.claude/settings.local.json
# Local Claude Code preview config — contains machine-specific paths, never commit
.claude/launch.json
# Private token list read by the pre-commit guard (scripts/check-private.sh) — never commit
.private-guard

# Job-scout WHO/WHAT — your real target companies and filters are private (public repo!).
# The *.example versions stay public so others can fork.
.claude/skills/job-scout/config.yaml
.claude/skills/job-scout/watchlist.txt

# Generated application docs (tailored CVs, cover letters) — your real history, keep private
applications/

# Session handoff / current-state note — references private targets & status, keep private
HANDOFF.md

# Keep empty dirs
!data/connections/.gitkeep
!data/digests/.gitkeep

# NOTE: The real career_facts.yaml and profile/0X-*.md (non-.example) ARE ignored by the rules
# above — they stay on your machine and are NEVER committed. Only the *.example templates and
# profile/00-README.md are public. To publish a *redacted* showcase of a profile file, copy a
# scrubbed version to e.g. profile/05-cv-source.public.md and un-ignore that exact path:
#   !profile/05-cv-source.public.md
# A pre-commit guard (scripts/check-private.sh) enforces this — enable it with:
#   git config core.hooksPath .githooks
